# SerpApi — real outdoor location search (requires internet)
SERPAPI_API_KEY=

# MongoDB Atlas — optional; quests fall back to in-memory storage if unset or unreachable
MONGODB_URI=
MONGODB_DB_NAME=trailquest_db

# Ollama — local open-weight model inference
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma3:4b
